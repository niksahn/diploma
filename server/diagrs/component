@startuml
skinparam componentStyle uml2
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 0
skinparam linetype ortho

skinparam nodesep 32
skinparam ranksep 14

skinparam componentBackgroundColor white
skinparam componentBorderColor black
skinparam componentFontColor black
skinparam componentFontSize 18

skinparam databaseBackgroundColor white
skinparam databaseBorderColor black
skinparam databaseFontColor black

skinparam arrowColor black
skinparam arrowThickness 1
skinparam defaultFontColor black

skinparam rectangleBorderColor white
skinparam rectangleFontColor white

left to right direction

rectangle " " as Front #white;line:white;text:white {
  component "Клиентское\nприложение" as Client <<component>>
  component "Сервис-шлюз" as Gateway <<component>>
  Client -[hidden]right- Gateway
}

rectangle " " as Services #white;line:white;text:white {
  top to bottom direction
  component "Сервис\nавторизации" as Auth <<component>>
  component "Сервис\nпользователей" as User <<component>>
  component "Сервис рабочих\nпространств" as Workspace <<component>>
  component "Сервис чатов\nи сообщений" as Chat <<component>>
  component "Сервис задач" as Task <<component>>
  component "Сервис жалоб" as Complaint <<component>>
}

rectangle " " as Data #white;line:white;text:white {
  top to bottom direction
  database "БД\nмессенджера" as DB
  component "Брокер сообщений" as Kafka <<component>>
  DB -[hidden]down- Kafka
}

Front -[hidden]right- Services
Services -[hidden]right- Data

Client -right-> Gateway

Gateway --> Auth
Gateway --> User
Gateway --> Workspace
Gateway --> Chat
Gateway --> Task
Gateway --> Complaint

Auth --> DB
User --> DB
Workspace --> DB
Chat --> DB
Task --> DB
Complaint --> DB

Complaint -right-> Kafka
Kafka -left-> User 

@enduml
