# API Gateway
VITE_API_BASE_URL=http://localhost:8080

# Grafana (раздел «Настройки и состояние»)
# В npm run dev по умолчанию используется прокси /grafana-proxy → 127.0.0.1:3000
# Раскомментируйте, если нужен прямой URL:
# VITE_GRAFANA_URL=http://127.0.0.1:3000
VITE_GRAFANA_DASHBOARD_UID=microservices-overview
VITE_GRAFANA_ORG_ID=1
VITE_GRAFANA_TIME_FROM=now-1h
VITE_GRAFANA_TIME_TO=now
VITE_GRAFANA_REFRESH=30s
